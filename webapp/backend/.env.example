# Copy this file to .env and edit as needed.

# ── Ollama local LLM (for AI interpretation) ──────────────────────────────
# Run: ollama serve   (in a separate terminal)
# Pull a small model that fits in 4 GB RAM, e.g.:
#   ollama pull llama3.2:1b
#   ollama pull qwen2.5:1.5b
#   ollama pull phi3:mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# Seconds to wait for Ollama before falling back to rule-based summary.
OLLAMA_TIMEOUT=60

# Fallback signal: sum of all models' predicted % changes vs last close.
# If sum > threshold → BUY, sum < -threshold → SELL, else HOLD. (0.05 = 0.05%)
SIGNAL_CONSENSUS_PCT_THRESHOLD=0.05

# ── Candle cache ──────────────────────────────────────────────────────────
# Where to cache fetched Binance candles (relative to this file).
CACHE_DIR=cache

# How many days of history to fetch on first request per coin.
HISTORY_DAYS=1825

# ── Server ────────────────────────────────────────────────────────────────
# CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173
