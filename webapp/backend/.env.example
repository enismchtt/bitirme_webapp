# Copy this file to .env and fill in your keys.

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model. gemini-1.5-flash has a generous free tier.
GEMINI_MODEL=gemini-1.5-flash

# Optional: Binance API key/secret (NOT required for public market data).
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Where to cache fetched Binance candles (relative to this file).
CACHE_DIR=cache

# How many days of history to fetch on first request per coin.
HISTORY_DAYS=1825

# CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173
